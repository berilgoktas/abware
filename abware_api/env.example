# Kopyala -> .env yap ve kendi değerlerini gir

# DB
DB_SERVER=10.0.0.4,1433
DB_DATABASE=ABWareDB
DB_USERNAME=sa
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# Security
JWT_SECRET_KEY=change-this-in-production
SECRET_KEY=change-this-too

# App
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=3001
SWAGGER_ENABLED=False

# CORS (Cloudflare domain'ini yaz)
# Prod: https://webservis.abware.com.tr
# Yerel Docker/Vite: http://localhost:3002
CORS_ORIGINS=https://webservis.abware.com.tr,https://abwaredemo.netlify.app,https://abware.netlify.app,http://localhost:3002,http://127.0.0.1:3002

# FX (EURTRY) - ürün fiyatı TL -> EUR dönüşümü ve stok hareket fiyatı için
# Varsayılan URL: frankfurter.app (ücretsiz). İstersen kendi servis URL'ini ver.
FX_EURTRY_URL=https://api.frankfurter.app/latest?from=EUR&to=TRY
FX_TIMEOUT_SECONDS=10


