# Kopyala -> env.staging yap ve kendi değerlerini gir
# STAGING/TEST ORTAMI İÇİN

# DB - Test Veritabanı
DB_SERVER=10.0.0.4,1433
DB_DATABASE=ABWareDB_Test
DB_USERNAME=sa
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# Security - Test için farklı secret key'ler kullan
JWT_SECRET_KEY=staging-secret-key-change-this
JWT_REFRESH_SECRET_KEY=staging-refresh-key-change-this
SECRET_KEY=staging-app-secret-change-this

# JWT Token süreleri
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# App - Test ortamı için debug açık
FLASK_ENV=development
FLASK_DEBUG=True
SWAGGER_ENABLED=True

# CORS - Test frontend URL'leri
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://abware-test.netlify.app

# FX (EURTRY) - ürün fiyatı TL -> EUR dönüşümü
FX_EURTRY_URL=https://api.frankfurter.app/latest?from=EUR&to=TRY
FX_TIMEOUT_SECONDS=10

# Staging Port (docker-compose.staging.yml tarafından kullanılır)
STAGING_PORT=5051
